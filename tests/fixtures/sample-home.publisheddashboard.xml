<publisheddashboard scriptid="custpubdashboard_sample">
    <center>BASIC</center>
    <locknewbar>F</locknewbar>
    <lockshortcuts>F</lockshortcuts>
    <name>Sample</name>
    <notes/>
    <roles>
        <role>
            <role>ACCOUNTANT</role>
        </role>
    </roles>
    <dashboards>
        <dashboard>
            <centertab>BASICCENTERHOMEHOME</centertab>
            <layout>TWO_COLUMN_RIGHT</layout>
            <mode>UNLOCKED</mode>
            <centercolumn>
                <customsearch>
                    <!-- TODO: Custom Search "Purchasing Tracking Items": replace customsearch_TODO_6532 with the script id of saved search 6532 -->
                    <savedsearch>[scriptid=customsearch_TODO_6532]</savedsearch>
                    <resultssize>20</resultssize>
                    <isminimized>F</isminimized>
                    <drilldown>NEW_PAGE</drilldown>
                    <charttheme>GLOBAL_THEME</charttheme>
                    <backgroundtype>GLOBAL_BACKGROUND</backgroundtype>
                    <allowinlineediting>T</allowinlineediting>
                </customsearch>
                <customsearch>
                    <!-- TODO: Custom Search "SOH Value by Item Category": replace customsearch_TODO_5151 with the script id of saved search 5151 -->
                    <savedsearch>[scriptid=customsearch_TODO_5151]</savedsearch>
                    <resultssize>20</resultssize>
                    <isminimized>F</isminimized>
                    <drilldown>NEW_PAGE</drilldown>
                    <charttheme>COLORFUL</charttheme>
                    <backgroundtype>GRID</backgroundtype>
                    <allowinlineediting>F</allowinlineediting>
                    <title>Stock on hand</title>
                </customsearch>
                <customsearch>
                    <!-- TODO: Custom Search "Inventory Movements": replace customsearch_TODO_3143 with the script id of saved search 3143 -->
                    <savedsearch>[scriptid=customsearch_TODO_3143]</savedsearch>
                    <resultssize>100</resultssize>
                    <isminimized>T</isminimized>
                    <drilldown>NEW_PAGE</drilldown>
                    <charttheme>GLOBAL_THEME</charttheme>
                    <backgroundtype>GLOBAL_BACKGROUND</backgroundtype>
                    <allowinlineediting>F</allowinlineediting>
                </customsearch>
                <kpireport>
                    <isminimized>F</isminimized>
                    <orientation>KPIs on Left</orientation>
                    <reportid>26</reportid>
                    <!-- TODO: KPI Scorecard "Stock Checks": reportid 26 is an account-specific internal id; custom scorecards may need a [scriptid=custkpiscorecard_x] reference -->
                    <restrict>All</restrict>
                    <showdates>F</showdates>
                    <trend>T</trend>
                </kpireport>
                <keyperformanceindicators>
                    <isminimized>F</isminimized>
                    <cacheddata>T</cacheddata>
                    <kpis>
                        <kpi>
                            <kpi>CUSTOM</kpi>
                            <!-- TODO: Key Performance Indicators "Key Performance Indicators" / Built Stock Valuation: replace customsearch_TODO_1768 with the script id of saved search 1768 -->
                            <savedsearch>[scriptid=customsearch_TODO_1768]</savedsearch>
                            <daterange>TODAY</daterange>
                            <periodrange>THIS_PERIOD</periodrange>
                            <compare>T</compare>
                            <comparedaterange>LAST_MONTH</comparedaterange>
                            <compareperiodrange>LAST_PERIOD</compareperiodrange>
                            <headline>F</headline>
                            <highlightif>GREATER_THAN</highlightif>
                            <threshold>2000000.00</threshold>
                        </kpi>
                        <kpi>
                            <kpi>SALES</kpi>
                            <daterange>THIS_MONTH</daterange>
                            <periodrange>THIS_PERIOD</periodrange>
                            <compare>T</compare>
                            <comparedaterange>LAST_MONTH_TO_DATE</comparedaterange>
                            <compareperiodrange>LAST_PERIOD</compareperiodrange>
                            <headline>F</headline>
                        </kpi>
                        <kpi>
                            <kpi>ORDERS</kpi>
                            <daterange>THIS_WEEK</daterange>
                            <compare>F</compare>
                            <headline>T</headline>
                        </kpi>
                    </kpis>
                </keyperformanceindicators>
                <customportlet>
                    <source>[scriptid=customscript_TODO.customdeploy_TODO]</source>
                    <!-- TODO: Custom Portlet "Budget vs. Actual": set the portlet script deployment reference (script source 2436_1, "Budget vs. Actual") -->
                    <isminimized>F</isminimized>
                </customportlet>
                <!-- skipped Custom Portlet "Company Sales Dashboard": SuiteApp dashboard portlets cannot be expressed in publisheddashboard XML -->
                <trendgraph>
                    <kpi>SALES</kpi>
                    <trendtype>WEEKLY</trendtype>
                    <movingaverageperiod>2</movingaverageperiod>
                    <isminimized>F</isminimized>
                    <backgroundtype>GLOBAL_BACKGROUND</backgroundtype>
                    <charttheme>MATCH_COLOR_THEME___BOLD</charttheme>
                    <defaultcharttype>LINE</defaultcharttype>
                    <includezeroonyaxis>F</includezeroonyaxis>
                    <showmovingaverage>T</showmovingaverage>
                    <showlastdatapoint>T</showlastdatapoint>
                </trendgraph>
                <settings>
                    <isminimized>T</isminimized>
                </settings>
            </centercolumn>
            <rightcolumn>
                <shortcuts>
                    <isminimized>F</isminimized>
                </shortcuts>
                <!-- TODO: Shortcuts: SDF only places the portlet; the links themselves are per-user (use the extension import to copy them) -->
                <kpimeter>
                    <kpi>INVENTORY</kpi>
                    <isminimized>F</isminimized>
                </kpimeter>
                <reminders>
                    <isminimized>F</isminimized>
                    <showzeroresults>F</showzeroresults>
                    <headline>
                        <reminder>
                            <id>BILLSTOAPPROVE</id>
                        </reminder>
                    </headline>
                    <other>
                        <reminder>
                            <!-- TODO: Reminders "Reminders" reminder Phone Call View: replace customsearch_TODO_132 with the script id of saved search 132 -->
                            <id>[scriptid=customsearch_TODO_132]</id>
                        </reminder>
                    </other>
                    <!-- TODO: Reminders "Reminders": per-reminder day thresholds and highlighting rules are not captured; add days / highlightingrules elements by hand if used -->
                </reminders>
                <lastlogin>
                    <isminimized>F</isminimized>
                    <showlastlogin>T</showlastlogin>
                    <showsuccesstoday>T</showsuccesstoday>
                </lastlogin>
                <list>
                    <type>CUSTOMER</type>
                    <size>5</size>
                    <isminimized>F</isminimized>
                    <allowinlineediting>T</allowinlineediting>
                </list>
            </rightcolumn>
        </dashboard>
    </dashboards>
</publisheddashboard>
